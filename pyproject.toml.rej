-[project]
-name = "marine_qc"
-authors = [
-  {name = "Ludwig Lierhammer", email = "ludwig.lierhammer@dwd.de"}
-]
-maintainers = [
-  {name = "Ludwig Lierhammer", email = "ludwig.lierhammer@dwd.de"}
-]
-readme = {file = "README.rst", content-type = "text/x-rst"}
-requires-python = ">=3.10.0"
-keywords = ["Marine Quality Control"]
-license = "Apache-2.0"
-license-files = ["LICENSE"]
-classifiers = [
-  "Development Status :: 2 - Pre-Alpha",
-  "Intended Audience :: Developers",
-  "Natural Language :: English",
-  "Operating System :: OS Independent",
-  "Programming Language :: Python :: 3",
-  "Programming Language :: Python :: 3 :: Only",
-  "Programming Language :: Python :: 3.10",
-  "Programming Language :: Python :: 3.11",
-  "Programming Language :: Python :: 3.12",
-  "Programming Language :: Python :: 3.13",
-  "Programming Language :: Python :: 3.14",
-  "Programming Language :: Python :: Implementation :: CPython",
-  "Typing :: Typed"
-]
-dynamic = ["description", "version"]
-dependencies = [
-  "click >=8.3.1"
-
-]
-
-[project.optional-dependencies]
-extras = []
-
-[project.scripts]
-marine_qc = "marine_qc.cli:app"
-
-[project.urls]
-# "Homepage" = "https://Marine-Quality-Control.readthedocs.io/"
-# "Changelog" = "https://Marine-Quality-Control.readthedocs.io/en/stable/changelog.html"
-# "About Ouranos" = "https://ouranos.ca/en/"
-"Issue tracker" = "https://github.com/glamod/Marine-Quality-Control/issues"
-"Source" = "https://github.com/glamod/Marine-Quality-Control"
-
